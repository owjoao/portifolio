{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Static portfolio - no build needed'",
  "installCommand": "npm install --prefix niches/dentista/server",
  "outputDirectory": "portal",
  "rewrites": [
    {
      "source": "/dentista/api/(.*)",
      "destination": "/api/dentista/$1"
    },
    {
      "source": "/api/dentista/(.*)",
      "destination": "niches/dentista/server/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "functions": {
    "niches/dentista/server/server.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}