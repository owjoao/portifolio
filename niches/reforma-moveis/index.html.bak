  <!-- ========================================================================= -->
  <!-- POR QUE ESCOLHER A RENOVA MÓVEIS (Faixa Escura com Métricas)              -->
  <!-- ========================================================================= -->
  <section id="sobre" class="reveal py-16 bg-renova-charcoal text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Lado Esquerdo -->
        <div class="lg:col-span-5 space-y-3">
          <span class="text-xs font-outfit font-extrabold uppercase tracking-widest text-renova-amber block">
