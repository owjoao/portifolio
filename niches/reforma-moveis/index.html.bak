        <a href="#servicos" class="hover:text-renova-amber transition">Serviços</a>
        <a href="#sobre" class="hover:text-renova-amber transition">Sobre</a>
        <a href="#depoimentos" class="hover:text-renova-amber transition">Depoimentos</a>
        <a href="#contato" class="hover:text-renova-amber transition">Contato</a>
