<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Renova Móveis | Reforma e Restauração de Móveis em São Paulo - SP</title>
  <meta name="description" content="Ateliê especializado em reforma e restauração de móveis em São Paulo - SP. Marcenaria fina, troca de tecidos e acabamentos nobres com coleta e entrega na Grande SP." />

  <!-- Google Fonts: Plus Jakarta Sans / Outfit / Caveat (para caligrafia manuscrita das anotações) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            outfit: ['Outfit', 'sans-serif'],
            script: ['Caveat', 'cursive'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            renova: {
              amber: '#DF9843',
              amberHover: '#C98232',
              darkWood: '#161310',
              charcoal: '#1C1815',
              cardDark: '#25201C',
              cardLight: '#FFFFFF',
              bgLight: '#FAF7F2',
              border: '#E8E1D7',
              borderDark: '#362E28',
              muted: '#7A726A'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="../assets/css/motion-core.css">

  <style>
    /* Linhas pontilhadas e setas curvas decorativas */
    .curved-arrow {
      font-family: 'Caveat', cursive;
      font-size: 26px;
      line-height: 1;
      color: #4A3E36;
    }
  </style>

  <!-- GSAP & ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>


  <!-- Schema.org SEO & GEO Data -->
  <script type="application/ld+json">
  {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "Ateliê Renova Móveis & Restauração",
  "description": "Restauração artesanal de móveis clássicos e contemporâneos, marcenaria fina e estofaria.",
  "telephone": "+55-32-99929-2311",
  "url": "https://nexusflow.digital/reforma-moveis/",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Paulista, 1000",
    "addressLocality": "São Paulo",
    "addressRegion": "SP",
    "postalCode": "01310-100",
    "addressCountry": "BR"
  }
}
  </script>

</head>
<body class="bg-renova-bgLight text-slate-800 font-sans antialiased selection:bg-renova-amber selection:text-white">

  <!-- ========================================================================= -->
  <!-- HEADER & NAVEGAÇÃO                                                        -->
