        <!-- Pilar 1 -->
        <div class="flex items-start gap-4 p-2">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-renova-amber flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-leaf"></i>
          </div>
          <div>
            <h4 class="font-outfit font-bold text-sm text-slate-900 leading-tight">Mais sustentabilidade</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">Reforme e evite o descarte precoce de móveis com valor sentimental.</p>
          </div>
