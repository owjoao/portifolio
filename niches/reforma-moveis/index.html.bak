  <!-- SCRIPTS INTERATIVOS & FORMULÁRIO WHATSAPP             -->
  <!-- ========================================================================= -->
  <script>
    // Envio do Formulário para WhatsApp
    function enviarOrcamento(e) {
      e.preventDefault();
      const nome = document.getElementById('form-nome').value.trim();
      const whatsapp = document.getElementById('form-whatsapp').value.trim();
      const servico = document.getElementById('form-servico').value || 'Reforma Geral';

      const bairro = (document.getElementById('form-bairro') ? document.getElementById('form-bairro').value.trim() : '') || 'São Paulo - SP';
      let msg = `gostei desse site, qual o valor?`;
      if (nome || whatsapp) {
        msg += `\n(Lead: ${nome} - ${whatsapp} - Local: ${bairro} - Serviço: ${servico})`;
      }

      const url = `https://wa.me/5532999292311?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    }
  </script>

