  <!-- ========================================================================= -->
  <!-- HERO SECTION (Identical to Reference Mockup Top Fold)                     -->
  <!-- ========================================================================= -->
  <section id="inicio" class="reveal relative min-h-[580px] md:min-h-[640px] flex items-center overflow-hidden bg-renova-darkWood">
    <!-- Imagem de Fundo (Cômoda de Madeira com Luz Dourada e Abajur) -->
    <div class="absolute inset-0 z-0">
      <img 
        src="assets/credenza-clean.jpg" 
        alt="Ambiente acolhedor com cômoda de madeira restaurada em madeira maciça com abajur e planta decorativa" 
        class="w-full h-full object-cover object-right-top md:object-center opacity-90"
        loading="eager"
      />
      <!-- Gradiente escuro à esquerda para legibilidade perfeita do texto -->
      <div class="absolute inset-0 bg-gradient-to-r from-renova-darkWood via-renova-darkWood/85 to-transparent md:to-renova-darkWood/30"></div>
    </div>

    <!-- Conteúdo Hero -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 py-16 md:py-24">
      <div class="max-w-2xl space-y-6">
        
        <!-- Tag -->
        <span class="text-[11px] font-outfit font-extrabold uppercase tracking-[0.2em] text-renova-amber block">
          Reforma e Restauração de Móveis
        </span>

        <!-- Título Principal com Assinatura em Script -->
