  <section id="depoimentos" class="reveal py-16 md:py-24 bg-white border-b border-renova-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <!-- Cabeçalho da Seção -->
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-outfit font-extrabold uppercase tracking-widest text-renova-amber">
          DEPOIMENTOS
        </span>
        <h2 class="font-outfit font-black text-3xl sm:text-4xl text-slate-900 tracking-tight mt-1">
          Quem já reformou, recomenda!
