# ==============================================================================
# LUMINA OS - AMBIENTE DE SEGURANÇA MÁXIMA (SERVER-SIDE ONLY)
# NUNCA ENVIE ESTE ARQUIVO OU SUAS CHAVES PARA O NAVEGADOR DO CLIENTE
# ==============================================================================

# 1. Configurações de Rede e Servidor
PORT=3001
NODE_ENV=production

# 2. Política Restrita de CORS (Origens Autorizadas)
# Especifique a URL da landing page pública e o painel administrativo
ALLOWED_ORIGINS=https://luminaodonto.com.br,https://admin.luminaodonto.com.br,http://localhost:8080

# 3. Credenciais Mestras do Supabase (Acesso Privilegiado de Infraestrutura)
# O front-end NUNCA acessa a service_role. Somente este backend possui acesso.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua_chave_service_role_mestra_aqui

# 4. Chave Secreta de Administração e Sessões (Substitui o PIN fixo hardcoded)
# O PIN nunca fica no HTML. Ele é validado exclusivamente na memória do servidor.
ADMIN_SECRET_PIN=948210
JWT_SECRET=lumina_super_secret_jwt_key_256bits_crypto_secure_token_change_me
JWT_EXPIRES_IN=8h

# 5. Proteção contra Força Bruta e Ataques de Negação de Serviço (DDoS)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
PUBLIC_BOOKING_RATE_LIMIT_HOURLY=10
