{
  "name": "nexus-flow-portfolio",
  "version": "1.0.0",
  "description": "NEXUS FLOW — Portfólio Organizado de Engenharia Digital & Sistemas de Vendas",
  "private": true,
  "scripts": {
    "build": "python scripts/build_clean_light_portal.py",
    "build:niche-db": "python scripts/build_niche_db.py",
    "build:all": "npm run build && npm run build:niche-db",
